{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "rmbd",
	"main": "src/index.ts",
	"compatibility_date": "2026-05-17",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true,

	// 定时触发器 — 每天北京时间 8:00 (UTC 0:00) 自动推送
	"triggers": {
		"crons": ["0 0 * * *"]
	},

	// ==========================================
	// 环境变量 — 在这里直接填入你的配置
	// ==========================================
	"vars": {
		// Movie-Pilot 实例地址，例如: https://mp.example.com
		"MOVIE_PILOT_URL": "",
		// Movie-Pilot JWT Bearer Token
		"MOVIE_PILOT_TOKEN": "",
		// TMDB API 密钥 (从 themoviedb.org 获取)
		"TMDB_API_KEY": "",
		// HtmlCssToImage API User ID (从 htmlcsstoimage.com 获取)
		"HCTI_API_ID": "",
		// HtmlCssToImage API Key
		"HCTI_API_KEY": "",
		// Telegram Bot Token (从 @BotFather 获取)
		"TG_BOT_TOKEN": "",
		// Telegram Chat ID (频道/群组/用户 ID)
		"TG_CHAT_ID": ""
	}
}