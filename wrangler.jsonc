{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "rmbd",
	"main": "src/index.ts",
	"compatibility_date": "2026-05-17",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true,

	// 定时触发器 — 每天北京时间 8:00 (UTC 0:00) 自动推送
	"triggers": {
		"crons": ["0 0 * * *"]
	},

	// ==========================================
	// 环境变量 — 在这里直接填入你的配置
	// ==========================================
	"vars": {
		// Movie-Pilot 实例地址，例如: https://mp.example.com
		"MOVIE_PILOT_URL": "https://mp.zhanghongmeng.cn:5238",
		// Movie-Pilot JWT Bearer Token
		"MOVIE_PILOT_TOKEN": "hLejBUmUOkgJFNmWeevPKwZ4f5x7sss6",
		// TMDB API 密钥 (从 themoviedb.org 获取)
		"TMDB_API_KEY": "6cb0121723c7904c862317c62665cbaf",
		// HtmlCssToImage API User ID (从 htmlcsstoimage.com 获取)
		"HCTI_API_ID": "01KRT1WE15XT6X6D87N16Q8CKH",
		// HtmlCssToImage API Key
		"HCTI_API_KEY": "019e341e-3825-7962-adac-9e160818f301",
		// Telegram Bot Token (从 @BotFather 获取)
		"TG_BOT_TOKEN": "8875150371:AAFcu1QJq3t41nTD7YyE4dczoXJwn1RBIGM",
		// Telegram Chat ID (频道/群组/用户 ID)
		"TG_CHAT_ID": "-1002296819403"
	}
}
