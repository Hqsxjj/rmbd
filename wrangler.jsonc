{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "rmbd",
	"main": "src/index.ts",
	"compatibility_date": "2026-05-17",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true,

	// 定时触发器 — 每天北京时间 8:00 (UTC 0:00) 自动推送
	"triggers": {
		"crons": ["0 0 * * *"]
	},

	// ==========================================
	// 环境变量由 Cloudflare Workers 控制台或 Wrangler Secrets 管理
	// ==========================================
}

