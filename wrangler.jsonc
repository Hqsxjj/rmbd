{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "rmbd",
	"main": "src/index.ts",
	"compatibility_date": "2026-05-17",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true,

	// 定时触发器 — 每天北京时间 8:00 (UTC 0:00) 自动推送
	"triggers": {
		"crons": ["0 0 * * *"]
	},

	// ==========================================
	// 环境变量 — 在这里直接填入你的配置
	// ==========================================
	"vars": {
		// TMDB API 密钥 (从 themoviedb.org 获取)
		"TMDB_API_KEY": "6cb0121723c7904c862317c62665cbaf",
		// Telegram Bot Token (从 @BotFather 获取)
		"TG_BOT_TOKEN": "8875150371:AAFcu1QJq3t41nTD7YyE4dczoXJwn1RBIGM",
		// Telegram Chat ID (频道/群组/用户 ID)
		"TG_CHAT_ID": "-1002296819403"
	}
}
